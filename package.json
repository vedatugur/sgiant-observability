{
  "name": "sgiant-observability",
  "version": "1.1.0",
  "description": "Shared pino logger and OpenTelemetry bootstrap: one package, two entry points.",
  "keywords": [
    "pino",
    "logger",
    "logging",
    "opentelemetry",
    "otel",
    "tracing",
    "observability",
    "structured-logging",
    "google-cloud-logging"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vedatugur/sgiant-observability.git"
  },
  "homepage": "https://github.com/vedatugur/sgiant-observability#readme",
  "bugs": {
    "url": "https://github.com/vedatugur/sgiant-observability/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.218.0",
    "@opentelemetry/sdk-node": "^0.218.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ]
}
